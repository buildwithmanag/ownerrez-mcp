# OwnerRez MCP server configuration
# =================================

# --- Credentials: choose ONE method ---

# Method A (preferred): OAuth access token.
# Obtain via `ownerrez-mcp auth` (needs an OAuth app; see below), then paste here.
OWNERREZ_ACCESS_TOKEN=

# Method B (simplest for a single account): Personal Access Token (HTTP Basic).
# Create under OwnerRez -> Settings -> API -> Personal Access Tokens.
# OWNERREZ_USERNAME=you@example.com
# OWNERREZ_TOKEN=your_personal_access_token

# --- Options ---

# Set to 1/true to block ALL write tools (messaging, expenses, webhook changes).
# OWNERREZ_READ_ONLY=0

# Retry attempts on 429/5xx (default 3) and request timeout seconds (default 30).
# OWNERREZ_MAX_RETRIES=3
# OWNERREZ_TIMEOUT=30

# Base URL override (default https://api.ownerrez.com/v2)
# OWNERREZ_BASE_URL=https://api.ownerrez.com/v2

# --- Webhook receiver + inbound-message store (optional [webhook] extra) ---
# Where captured inbound messages are stored (default ~/.ownerrez-mcp/messages.db)
# OWNERREZ_STORE=
# OWNERREZ_WEBHOOK_HOST=0.0.0.0
# OWNERREZ_WEBHOOK_PORT=8000
# Optional shared secret; send as X-Webhook-Secret header or ?secret= query param
# OWNERREZ_WEBHOOK_SECRET=

# --- OAuth app (only needed for `ownerrez-mcp auth`) ---
# Create an OAuth app in OwnerRez -> Settings -> API -> OAuth Apps.
# OWNERREZ_CLIENT_ID=
# OWNERREZ_CLIENT_SECRET=
# OWNERREZ_REDIRECT_URI=http://localhost:8017/callback
# Override only if OwnerRez changes its OAuth endpoints:
# OWNERREZ_AUTHORIZE_URL=https://app.ownerrez.com/oauth/authorize
# OWNERREZ_TOKEN_URL=https://api.ownerrez.com/oauth/access_token
